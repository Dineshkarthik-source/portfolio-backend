# MongoDB Atlas connection string (from your Atlas cluster's "Connect" button)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Random long secret string used to sign login tokens — make this up yourself, keep it secret
JWT_SECRET=change-this-to-a-long-random-string

# The bcrypt hash of your admin password — generate with: node generate-password-hash.js "yourPassword"
ADMIN_PASSWORD_HASH=paste-generated-hash-here

# Your live frontend URL once deployed, e.g. https://dhinesh-portfolio.netlify.app
# Use * while testing locally, lock it down once you have your real domain
ALLOWED_ORIGIN=*

PORT=5000
